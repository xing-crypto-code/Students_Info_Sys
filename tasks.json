{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe 生成活动文件",
            "command": "C:\\bandizip\\mingw64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                // 编译程序入口文件。
                "${workspaceFolder}\\Src\\main.c",
                // 编译学生信息管理功能。
                "${workspaceFolder}\\Src\\stu.c",
                // 编译文件读写功能。
                "${workspaceFolder}\\Src\\file.c",
                // 编译控制台初始化功能。
                "${workspaceFolder}\\Src\\console.c",
                // 指定头文件所在目录。
                "-I",
                "${workspaceFolder}\\Inc",
                // 指定生成的可执行文件路径。
                "-o",
                "${workspaceFolder}\\student_system.exe"
            ],
            "options": {
                // 使用工作区根目录作为构建工作目录。
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ],
    "version": "2.0.0"
}