{
    "version": 4,
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/lvgl",
                "${workspaceFolder}/SDL2-2.32.10/x86_64-w64-mingw32/include"
            ],
            "defines": [
                "LV_CONF_INCLUDE_SIMPLE",
                "LV_LVGL_H_INCLUDE_SIMPLE",
                "LV_KCONFIG_IGNORE"
            ],
            "compilerPath": "${workspaceFolder}/mingw64/bin/gcc.exe",
            "cStandard": "c99",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "windows-gcc-x64"
        }
    ]
}
