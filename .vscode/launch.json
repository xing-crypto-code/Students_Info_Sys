{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试 LVGL 模拟器 (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/main.exe",
            "args": [],
            "stopAtEntry": false,
            // 必须用 bin 作为工作目录：字体 (fonts)、帮助图片 (help_png)、
            // students.csv 都在 bin 下，lv_conf.h 里的 A: 盘也指向这里。
            "cwd": "${workspaceFolder}/bin",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\bandizip\\mingw64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "构建 LVGL 模拟器"
        }
    ]
}
